{
  "name": "yt-preview-handoff",
  "private": true,
  "scripts": {
    "lint": "web-ext lint",
    "build": "web-ext lint && web-ext build --overwrite-dest --filename \"yt-preview-handoff-{version}.xpi\"",
    "start": "web-ext run --start-url https://www.youtube.com",
    "sign": "web-ext sign --channel unlisted"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
